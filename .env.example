# Only needed for the "no partner here yet" lead-capture form on ad slots
# (src/components/LeadForm.tsx). Every calculator itself works with none of
# these set — this is not a general backend, just where lead submissions go.
#
# Get these values from Firebase Console > Project settings > General >
# Your apps > (web app) > SDK setup and configuration > Config. They're
# public client keys, safe to commit as an example / set as plain (not
# secret) env vars in Railway — access is restricted by Firestore security
# rules, not by hiding these.
#
# Local dev: copy this file to .env.local and fill in real values.
# Production: set the same VITE_FIREBASE_* keys in Railway's service
# variables (they must be set at BUILD time since Vite bakes them into the
# bundle — a plain redeploy after adding them is enough, no code change).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
